# Copy to .env. Every value here is a safe local default; nothing in this file is a secret.
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# Non-default ports so Crucible can coexist with whatever else is already running locally.
DATABASE_URL=postgresql+asyncpg://crucible:crucible@localhost:5434/crucible
REDIS_URL=redis://localhost:6380/0

API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
APP_URL=http://localhost:3200

# Change this for anything that is not your laptop. Must be at least 32 characters.
JWT_SECRET=dev-secret-change-me-please-32-chars-min

# Must be true whenever APP_URL is https. With ENV=prod, the process refuses to boot if either
# this or JWT_SECRET is still a development value — see RUNBOOK.md.
COOKIE_SECURE=false

# Provider credentials are optional. With none set, the built-in deterministic `mock` provider
# still runs every suite, every test and the benchmark — the platform is usable offline.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

DEFAULT_RUN_CONCURRENCY=8
MAX_RUN_CONCURRENCY=32
CASE_LEASE_SECONDS=120
MAX_CASE_ATTEMPTS=3
RESPONSE_CACHE_ENABLED=true
JUDGE_MODEL=claude-haiku-4-5
